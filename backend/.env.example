# Z CLIPS — environment configuration
# Copy to .env and fill in real values. NEVER commit a filled .env.
# All secrets are placeholders here; generate long random values.

APP_ENV=development
DATABASE_URL=sqlite:///./zclips.db
# PostgreSQL example (production):
# DATABASE_URL=postgresql+psycopg2://zclips:REPLACE_WITH_DB_PASSWORD@localhost:5432/zclips
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
OWNER_SETUP_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ONE_TIME_TOKEN_AT_LEAST_32_CHARS
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Storage (defaults to ./storage under the project root)
STORAGE_DIR=./storage
MODEL_DIR=./storage/models
MAX_UPLOAD_MB=2048
MAX_SCREENSHOT_MB=10

# NayaPay QR code image (optional). Place the owner's QR image at this path.
# When no file exists there, the payment page shows "QR code not yet provided".
NAYAPAY_QR_PATH=./storage/nayapay-qr.png

# YouTube Data API v3 key (optional). Without it, YT Monitoring live-status
# checks report "not configured" instead of pretending to know a status.
YOUTUBE_API_KEY=

# Background clip worker
WORKER_POLL_SECONDS=5
WORKER_ID=worker-1

# Trust X-Forwarded-For only when behind a trusted reverse proxy.
TRUST_PROXY=false
