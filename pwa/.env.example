# Z CLIPS PWA — copy to .env.local and fill in. Placeholders only; never commit real secrets.
FASTAPI_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public backend URL the browser posts video files to DIRECTLY (bypasses
# the Vercel proxy, which rejects bodies over ~4.5 MB). Required in
# production, e.g. NEXT_PUBLIC_FASTAPI_URL=https://z-clips.ethiodeploy.app.
# When unset, file uploads fall back to the proxied /api/v1 path.
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000
